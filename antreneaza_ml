import random
import numpy as np
import spacy
from spacy.training import Example
from spacy.scorer import Scorer
from spacy.util import filter_spans

rng = np.random.default_rng(seed=42)

CUVINTE_FIRME = ["ALFA", "OMEGA", "APEX", "VERTEX", "NOVA", "GLOBAL", "PRIME", "NEXTGEN", "CLOUD", "QUANTUM", "PACIFIC", "ATLANTIC", "DANUBE", "EURO", "TECH", "SILVER", "BRIGHT", "SUMMIT"]
DOMENII_FIRME = ["SOLUTIONS", "GROUP", "LOGISTICS", "SERVICES", "LABS", "NETWORKS", "RETAIL", "CONSULTING", "PARTNERS", "HOLDING", "DIGITAL", "ENERGY", "DESIGN", "SYSTEMS", "MEDIA"]
FORME_RO = ["S.R.L.", "SRL", "S.A.", "SA", "P.F.A.", "I.I."]
FORME_EN = ["LLC", "INC.", "LTD.", "CORP.", "PLC", "GMBH", "LLP"]

ETICHETE_FURNIZOR_RO = ["Furnizor:", "Vanzator:", "Prestator:", "Emitent:", "Distribuitor:", "Firma:", "Unitate emitenta:"]
ETICHETE_FURNIZOR_EN = ["Vendor:", "Billed by:", "Billed From:", "From:", "Supplier:", "Company:"]

ETICHETE_CLIENT_RO = ["Client:", "Cumparator:", "Beneficiar:", "Catre abonat:", "Catre:"]
ETICHETE_CLIENT_EN = ["Bill to:", "Billed to:", "Customer:", "Client:", "Ship to:"]

ETICHETE_CUI_RO = ["CUI:", "CIF:", "C.U.I.:", "Cod Fiscal:", "Cod unic de inregistrare:"]
ETICHETE_CUI_EN = ["VAT ID:", "Tax ID:", "EIN:", "VAT Reg No:", "GST No:", "Reg. No:"]

ETICHETE_FACTURA_RO = ["Factura nr:", "Factura fiscala nr.", "Seria si nr:", "Doc. Nr.:", "Numar factura:"]
ETICHETE_FACTURA_EN = ["Invoice #", "Invoice No:", "Invoice Number:", "Invoice ID:", "Bill #"]

ETICHETE_DATA_RO = ["Data:", "Data emiterii:", "Data facturarii:", "Data document:"]
ETICHETE_DATA_EN = ["Invoice Date:", "Date:", "Issue Date:", "Issued on:"]

ETICHETE_TOTAL_RO = ["Total de plata:", "Total General:", "Total factura:", "Suma de plata:", "Valoare totala:", "De achitat:"]
ETICHETE_TOTAL_EN = ["Total Due:", "Grand Total:", "Amount Due:", "Balance Due:", "Total Amount:", "Total:"]

LUNI_EN = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December", "Jan", "Feb", "Mar", "Apr", "Aug", "Sep", "Oct", "Nov", "Dec"]


def genereaza_nume_firma(limba="RO"):
    cuv1 = rng.choice(CUVINTE_FIRME)
    cuv2 = rng.choice(DOMENII_FIRME)
    if limba == "RO":
        prefix = rng.choice(["SC ", "S.C. ", "", ""])
        forma = rng.choice(FORME_RO)
        return f"{prefix}{cuv1} {cuv2} {forma}"
    else:
        forma = rng.choice(FORME_EN)
        return f"{cuv1} {cuv2} {forma}"


def genereaza_valori_factura(limba="RO"):
    furnizor = genereaza_nume_firma(limba)
    client = genereaza_nume_firma(limba)
    while client == furnizor:
        client = genereaza_nume_firma(limba)

    if limba == "RO":
        prefix_cui = rng.choice(["RO", "RO ", ""])
        cui = f"{prefix_cui}{rng.integers(1000000, 99999999)}"
    else:
        stil_cui = rng.choice(["EIN", "EU_VAT"])
        if stil_cui == "EIN":
            cui = f"{rng.integers(10, 99)}-{rng.integers(1000000, 9999999)}"
        else:
            tara = rng.choice(["GB", "DE", "FR", "NL", "IE"])
            cui = f"{tara}{rng.integers(100000000, 999999999)}"

    serie = "".join(rng.choice(list("ABCDEFGHJKLMNPQRSTUVWXYZ"), size=rng.integers(2, 4)))
    sep_nr = rng.choice(["-", "/", ""])
    nr_factura = f"{serie}{sep_nr}{rng.integers(100, 99999)}"

    zi = rng.integers(1, 29)
    luna = rng.integers(1, 13)
    an = rng.choice(["2024", "2025", "2026"])

    if limba == "RO":
        sep_data = rng.choice([".", "/", "-"])
        data_factura = f"{zi:02d}{sep_data}{luna:02d}{sep_data}{an}"
    else:
        if rng.random() < 0.6:
            nume_luna = rng.choice(LUNI_EN)
            data_factura = f"{nume_luna} {zi}, {an}"
        else:
            data_factura = f"{an}-{luna:02d}-{zi:02d}"

    suma_int = rng.integers(100, 25000)
    zecimale = rng.choice(["00", "50", "40", "99", "20"])
    if limba == "RO":
        total_plata = f"{suma_int:,}".replace(",", ".") + f",{zecimale}" if suma_int >= 1000 else f"{suma_int},{zecimale}"
    else:
        total_plata = f"{suma_int:,}.{zecimale}" if suma_int >= 1000 else f"{suma_int}.{zecimale}"

    return {
        "FURNIZOR": furnizor,
        "CLIENT": client,
        "CUI": cui,
        "NUMAR_FACTURA": nr_factura,
        "DATA_FACTURA": data_factura,
        "TOTAL_PLATA": total_plata
    }


def asambleaza_factura_text():
    limba = rng.choice(["RO", "EN"])
    v = genereaza_valori_factura(limba)

    if limba == "RO":
        ef = rng.choice(ETICHETE_FURNIZOR_RO)
        ec = rng.choice(ETICHETE_CLIENT_RO)
        ecui = rng.choice(ETICHETE_CUI_RO)
        enr = rng.choice(ETICHETE_FACTURA_RO)
        ed = rng.choice(ETICHETE_DATA_RO)
        etot = rng.choice(ETICHETE_TOTAL_RO)
        moneda = rng.choice(["RON", "Lei", "EUR"])
        stil = rng.integers(1, 4)

        if stil == 1:
            text = (
                f"FACTURA FISCALA\n{enr} {v['NUMAR_FACTURA']} | {ed} {v['DATA_FACTURA']}\n\n"
                f"{ef} {v['FURNIZOR']}\n{ecui} {v['CUI']}\n\n"
                f"{ec} {v['CLIENT']}\n\n"
                f"1. Servicii conform contract ......... 500,00 {moneda}\n"
                f"{etot} {v['TOTAL_PLATA']} {moneda}"
            )
        elif stil == 2:
            text = (
                f"{v['FURNIZOR']}\n{ecui} {v['CUI']}\n\n"
                f"{ec} {v['CLIENT']}\n{enr} {v['NUMAR_FACTURA']}\n{ed} {v['DATA_FACTURA']}\n\n"
                f"{etot} {v['TOTAL_PLATA']} {moneda}"
            )
        else:
            text = (
                f"{ef} {v['FURNIZOR']} ({ecui} {v['CUI']})\n"
                f"{ec} {v['CLIENT']}\n"
                f"Document: {enr} {v['NUMAR_FACTURA']} / {ed} {v['DATA_FACTURA']}\n"
                f"{etot} {v['TOTAL_PLATA']} {moneda}"
            )
    else:
        ef = rng.choice(ETICHETE_FURNIZOR_EN)
        ec = rng.choice(ETICHETE_CLIENT_EN)
        ecui = rng.choice(ETICHETE_CUI_EN)
        enr = rng.choice(ETICHETE_FACTURA_EN)
        ed = rng.choice(ETICHETE_DATA_EN)
        etot = rng.choice(ETICHETE_TOTAL_EN)
        simbol = rng.choice(["$", "€", "£", "USD "])
        stil = rng.integers(1, 4)

        if stil == 1:
            # Stil US/UK cu Billed From / Billed To pe rândul următor
            text = (
                f"INVOICE\n{enr} {v['NUMAR_FACTURA']}\n{ed} {v['DATA_FACTURA']}\n\n"
                f"{ef}\n{v['FURNIZOR']}\n{ecui} {v['CUI']}\n\n"
                f"{ec}\n{v['CLIENT']}\n\n"
                f"Subtotal: {simbol}1,000.00\nTax (8%): {simbol}80.00\n"
                f"{etot} {simbol}{v['TOTAL_PLATA']}"
            )
        elif stil == 2:
            # Stil fără etichetă la Furnizor (numele companiei direct în antet)
            text = (
                f"{v['FURNIZOR']}\n{ecui} {v['CUI']}\n\n"
                f"{enr} {v['NUMAR_FACTURA']} | {ed} {v['DATA_FACTURA']}\n"
                f"{ec} {v['CLIENT']}\n\n"
                f"Description: Software Development Services\n"
                f"{etot} {simbol}{v['TOTAL_PLATA']}"
            )
        else:
            # Stil compact pe un singur rând
            text = (
                f"TAX INVOICE\n{ef} {v['FURNIZOR']} ({ecui} {v['CUI']})\n"
                f"{ec} {v['CLIENT']}\n"
                f"{enr} {v['NUMAR_FACTURA']} | {ed} {v['DATA_FACTURA']}\n"
                f"Net Amount: 500.00 | VAT: 95.00\n"
                f"{etot} {v['TOTAL_PLATA']} USD"
            )

    return text, v


def creeaza_dataset_spacy(nlp_blank, numar_facturi=300):
    dataset = []
    for _ in range(numar_facturi):
        text, valori = asambleaza_factura_text()
        doc = nlp_blank.make_doc(text)
        spans = []

        for eticheta, valoare_text in valori.items():
            start_idx = text.rfind(valoare_text) if eticheta == "TOTAL_PLATA" else text.find(valoare_text)
            if start_idx != -1:
                end_idx = start_idx + len(valoare_text)
                span = doc.char_span(start_idx, end_idx, label=eticheta, alignment_mode="contract")
                if span is not None:
                    spans.append(span)

        doc.ents = filter_spans(spans)
        dataset.append(doc)
    return dataset


def evalueaza_modelul(nlp_model, date_test):
    exemple_test = [Example(nlp_model(d.text), d) for d in date_test]
    scoruri = Scorer().score(exemple_test)
    return scoruri["ents_f"] * 100


def antreneaza_si_testeaza(numar_facturi=300, epoci=25, folder_salvare="model_facturi_ml"):
    # Folosim tokenizatorul multilingv "xx" sau "ro"
    nlp_custom = spacy.blank("ro")
    ner = nlp_custom.add_pipe("ner")

    toate_datele = creeaza_dataset_spacy(nlp_custom, numar_facturi)
    for doc in toate_datele:
        for ent in doc.ents:
            ner.add_label(ent.label_)

    limita_split = int(numar_facturi * 0.8)
    date_antrenament = toate_datele[:limita_split]
    date_test = toate_datele[limita_split:]

    print(f"Antrenament bilingv (RO + EN): {len(date_antrenament)} facturi învățare | {len(date_test)} facturi test orb.\n")
    optimizer = nlp_custom.begin_training()

    for epoca in range(epoci):
        random.shuffle(date_antrenament)
        pierderi = {}
        for i in range(0, len(date_antrenament), 8):
            batch_docs = date_antrenament[i:i+8]
            exemple_batch = [Example(nlp_custom.make_doc(d.text), d) for d in batch_docs]
            nlp_custom.update(exemple_batch, sgd=optimizer, drop=0.25, losses=pierderi)

        if (epoca + 1) % 5 == 0 or epoca == 0:
            acuratete = evalueaza_modelul(nlp_custom, date_test)
            print(f"Epoca {epoca + 1:02d}/{epoci} | Loss: {pierderi['ner']:6.1f} | Acuratețe RO+EN (Test): {acuratete:.1f}%")

    nlp_custom.to_disk(folder_salvare)
    print(f"\nModelul bilingv (RO + EN) a fost salvat în '{folder_salvare}'!")


if __name__ == "__main__":
    antreneaza_si_testeaza()
